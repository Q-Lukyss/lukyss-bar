# À copier en `.env` à côté de docker-compose.prod.yml sur le serveur de
# prod (jamais commité — cf. .gitignore). Utilisé par
# `docker compose -f docker-compose.prod.yml --env-file .env up -d`.

# Domaines (DNS pointant vers ce serveur ; le certificat TLS est géré par la
# stack Traefik existante, pas par ce projet)
DOMAIN=exemple.fr
API_DOMAIN=api.exemple.fr

# Reverse proxy Traefik (stack séparée déjà déployée sur ce VPS, cf. README
# "Reverse proxy (Traefik)") — à faire correspondre exactement à cette
# stack existante : nom du réseau docker externe, entrypoint HTTPS et
# certresolver qu'elle expose.
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Images — api et web se versionnent indépendamment (tags git séparés
# api-vX.Y.Z / web-vX.Y.Z, cf. README "CI/CD"). cd.yml met à jour ces deux
# lignes sur le serveur à chaque déploiement ; les valeurs ci-dessous ne
# servent que de valeurs par défaut si le fichier est recréé à la main.
GHCR_IMAGE_API=ghcr.io/q-lukyss/lukyss-bar-api
GHCR_IMAGE_WEB=ghcr.io/q-lukyss/lukyss-bar-web
IMAGE_TAG_API=latest
IMAGE_TAG_WEB=latest

# Postgres
POSTGRES_DB=lukyssbar
POSTGRES_USER=lukyss
POSTGRES_PASSWORD=change-me

# API
JWT_SECRET=change-me
FRONTEND_URL=https://exemple.fr
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
