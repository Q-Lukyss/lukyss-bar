  "query": "UPDATE cocktails\n           SET name = COALESCE($2, name),\n               price = COALESCE($3, price),\n               description = COALESCE($4, description),\n               image = COALESCE($5, image),\n               updated_at = now()\n           WHERE id = $1\n           RETURNING id, name, description, image, price, created_at, updated_at",
