{
  "name": "@lukyss-bar/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cargo run",
    "build": "cargo build --release",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "check-types": "cargo check --all-targets",
    "test": "cargo test",
    "sdk": "cargo run --bin export_types",
    "db:migrate": "sqlx migrate run",
    "db:seed": "cargo run --bin seed",
    "db:reset": "sqlx database drop -y && sqlx database create && npm run db:migrate && npm run db:seed"
  }
}
